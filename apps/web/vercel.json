{
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://macgly.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://macgly.onrender.com/sitemap.xml"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{2,5}$).*)",
      "destination": "/_shell.html"
    }
  ]
}
