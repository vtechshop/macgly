# =============================================================================
# MACGLY — Environment variables reference
# Copy to .env and fill in real values. Never commit .env.
#
# REQUIRED = startup fails in production without this value
# OPTIONAL = feature is disabled or falls back safely when unset
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────

# REQUIRED — 'production' | 'staging' | 'development'
NODE_ENV=development

# OPTIONAL — defaults to 5000
PORT=5000

# REQUIRED — full MongoDB connection string (Atlas recommended)
MONGO_URI=mongodb://localhost:27017/shop

# OPTIONAL — Redis for rate-limit state and session caching.
#             If unset, the app falls back to in-process memory (single-instance safe).
REDIS_URL=

# ── Authentication ────────────────────────────────────────────────────────────

# REQUIRED — use: openssl rand -hex 64
# render.yaml generates these automatically on first deploy.
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# OPTIONAL — defaults shown
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# REQUIRED in production — use: openssl rand -hex 32
# render.yaml generates this automatically on first deploy.
CSRF_SECRET=change_me_csrf

# ── Payments (Razorpay) ───────────────────────────────────────────────────────

# OPTIONAL — without these, Razorpay order creation returns an error.
#             COD and wallet flows still work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# REQUIRED — copied from the Razorpay dashboard → Webhooks.
#             Without it, payment webhook signature verification fails and
#             all paid orders stay in 'pending' status.
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────

# REQUIRED — without these, product image upload and KYC upload fail.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────

# OPTIONAL — without this, emails are logged to stdout instead of sent.
#             Order confirmations, password resets, and KYC decisions will not deliver.
RESEND_API_KEY=

# ── Shipping ──────────────────────────────────────────────────────────────────

# OPTIONAL — Delhivery surface shipping. If unset, shipping quotes are unavailable.
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_SURFACE_API_URL=https://api.delhivery.com/v1
# Name of the pickup location as registered in the Delhivery dashboard
DELHIVERY_PICKUP_LOCATION=
# Pincode of the pickup warehouse (used for shipping-cost calculation)
DELHIVERY_PICKUP_PINCODE=641006
# Internal name alias used in shipment creation calls (can match DELHIVERY_PICKUP_LOCATION)
DELHIVERY_PICKUP=Primary

# OPTIONAL — Shiprocket. Used as fallback if Delhivery is not configured.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── AI chatbot ────────────────────────────────────────────────────────────────

# OPTIONAL — chatbot endpoint returns 503 when unset; the rest of the app is unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ── WhatsApp notifications ────────────────────────────────────────────────────

# OPTIONAL — notification functions silently no-op when these are unset.
# WHATSAPP_TOKEN is a permanent access token from Meta Business → WhatsApp → API Setup.
# WHATSAPP_PHONE_NUMBER_ID is the phone number ID (not the phone number itself).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── GST ───────────────────────────────────────────────────────────────────────

# OPTIONAL — state code for the platform's own GST registration.
#             33 = Tamil Nadu (default, matches Coimbatore address).
PLATFORM_GST_STATE_CODE=33

# OPTIONAL — GST Suvidha Provider API for real-time GSTIN verification.
#             When unset, verification returns 'unavailable' and vendor activation
#             works without a confirmed GSTIN check.
GST_API_URL=
GST_API_KEY=

# ── Platform legal identity (printed on tax invoices) ─────────────────────────

# REQUIRED for correct invoices — blank GSTIN renders visibly wrong on the invoice.
PLATFORM_GSTIN=

# OPTIONAL — these default to Macgly / Coimbatore address if unset.
PLATFORM_LEGAL_NAME=Macgly
PLATFORM_TRADE_NAME=Macgly
PLATFORM_PAN=
PLATFORM_EMAIL=support@macgly.com
PLATFORM_PHONE=9944556683
PLATFORM_ADDR_LINE1=9/83, E, 4th Street, T.Balan Nagar
PLATFORM_ADDR_LINE2=Ganapathipudur
PLATFORM_ADDR_CITY=Coimbatore
PLATFORM_ADDR_STATE=Tamil Nadu
PLATFORM_ADDR_PINCODE=641006

# ── Frontend / CORS ────────────────────────────────────────────────────────────

# REQUIRED — the exact origin the browser frontend is served from.
#             In staging: your Vercel preview URL or custom staging domain.
#             Additional allowed origins (macgly.com, macgly.vercel.app) are
#             hardcoded in app.js — add staging origins there if needed.
FRONTEND_URL=http://localhost:5173

# ── Scheduler ─────────────────────────────────────────────────────────────────

# OPTIONAL — set to 'true' to prevent background jobs from running (used in tests).
#             Never set in production.
# DISABLE_JOBS=true
